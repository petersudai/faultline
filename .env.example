# Copy to .env and fill in. .env is gitignored — never commit it.
# This file (.env.example) IS committed — keep only placeholders here.

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Classic PAT with NO scopes checked (public read only). github.com/settings/tokens/new
# Not needed to reproduce the eval (committed .cache/ + --offline covers that).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional. Default: claude-haiku-4-5-20251001 — the validated path for every
# number in results/ and the docs. claude-sonnet-5 mostly runs the direct call
# but still hard-fails schema validation on ~2/12 cases (non-deterministic);
# --deep on Sonnet ran error-free in a 1-seed probe but is unevaluated.
FAULTLINE_MODEL=claude-haiku-4-5-20251001
