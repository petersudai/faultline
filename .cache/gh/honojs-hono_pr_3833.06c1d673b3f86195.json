  "title": "fix(compress): don't compress server-sent events",
  "user": {
    "login": "dmitri-gb",
    "id": 6221386,
    "node_id": "MDQ6VXNlcjYyMjEzODY=",
    "avatar_url": "https://avatars.githubusercontent.com/u/6221386?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/dmitri-gb",
    "html_url": "https://github.com/dmitri-gb",
    "followers_url": "https://api.github.com/users/dmitri-gb/followers",
    "following_url": "https://api.github.com/users/dmitri-gb/following{/other_user}",
    "gists_url": "https://api.github.com/users/dmitri-gb/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/dmitri-gb/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/dmitri-gb/subscriptions",
    "organizations_url": "https://api.github.com/users/dmitri-gb/orgs",
    "repos_url": "https://api.github.com/users/dmitri-gb/repos",
